/******************************
  Compiler Directives
*******************************/
// #ENABLE_DYNAMIC
#SYMBOL_NAME "TSI - Password Utility - Node"
#CATEGORY "46" "#TSI Modules" // Custom
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE
                   
#DEFINE_CONSTANT			Max_Password_Size		16
#DEFINE_CONSTANT			Max_Password_Count		10
                
#Includepath "C:\Users\jpride\source\repos\SecurityPasswordUtility\SecurityPasswordUtility\bin\Debug"
#User_SimplSharp_Library "SecurityPasswordUtility"


/**************************
  DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
***************************/

DIGITAL_INPUT		Compare; 

STRING_INPUT		userInput$[Max_Password_Size],
					backdoor$[Max_Password_Size],
					_skip_;

DIGITAL_OUTPUT 		fail,
					backdoor_pass,
                    _skip_,
                    pass[Max_Password_Count];


PasswordNode node;

 

/*************************
  Event Handlers
**************************/

function RegisterEvents() {
    RegisterEvent(node, PasswordSuccess, OnPasswordSuccess);
    RegisterEvent(node, BackdoorPasswordSuccess, OnBackdoorPasswordSuccess);
    RegisterEvent(node, PasswordFailure, OnPasswordFailure);
}


change backdoor$ {
    node.LocalBackdoorPass = backdoor$;
}

push Compare {
    node.Compare(userInput$);
}

eventhandler OnPasswordSuccess(PasswordNode sender, PasswordSuccessEventArgs args) {
    integer sp;

    sp = args.index + 1;
    pulse(100,pass[sp]);
}

eventhandler OnBackdoorPasswordSuccess(PasswordNode sender, EventArgs args) {
    pulse(100, backdoor_pass);
}
eventhandler OnPasswordFailure(PasswordNode sender, EventArgs args) {
    pulse(100, fail);
}


Function Main() {
    RegisterEvents();
	WaitForInitializationComplete();
    node.LocalBackdoorPass = backdoor$;
	node.Initialize();
}


